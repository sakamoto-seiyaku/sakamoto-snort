 HevSocks5SessionUDP *
+hev_socks5_session_udp_direct_new (struct udp_pcb *pcb, HevTaskMutex *mutex,
+                                  unsigned int frame_limit)
+{
+    HevSocks5SessionUDP *self;
+
+    if (!pcb || !mutex || !frame_limit || frame_limit > 0x7fffffffU)
+        return NULL;
+    self = hev_malloc0 (sizeof (*self));
+    if (!self)
+        return NULL;
+    /* Parent construction creates no socket and reads no tunnel config. */
+    if (hev_socks5_client_udp_construct (&self->base,
+                                        HEV_SOCKS5_TYPE_UDP_IN_UDP) < 0) {
+        hev_free (self);
+        return NULL;
+    }
+    HEV_OBJECT (self)->klass = HEV_SOCKS5_SESSION_UDP_TYPE;
+    self->pcb = pcb;
+    self->mutex = mutex;
+    self->data.self = self;
+    self->direct_frame_limit = frame_limit;
+    udp_recv (pcb, udp_recv_handler, self);
+    return self;
+}
+
+int
+hev_socks5_session_udp_direct_send (HevSocks5SessionUDP *self)
+{
+    struct iovec spans[64];
+    struct msghdr msg = { 0 };
+    HevSocks5UDPFrame *frame;
+    HevListNode *node;
+    struct pbuf *p;
+    ssize_t result;
+    unsigned int count = 0;
+
+    if (!self->direct_frame_limit || self->base.fd < 0)
+        return -1;
+    node = hev_list_first (&self->frame_list);
+    if (!node)
+        return 0;
+    frame = container_of (node, HevSocks5UDPFrame, node);
+    for (p = frame->data; p; p = p->next) {
+        if (count == sizeof (spans) / sizeof (spans[0]))
+            return -1;
+        spans[count].iov_base = p->payload;
+        spans[count++].iov_len = p->len;
+    }
+    msg.msg_iov = spans;
+    msg.msg_iovlen = count;
+    result = sendmsg (self->base.fd, &msg, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (result < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+            return 0;
+        return -1;
+    }
+    if ((size_t) result != frame->data->tot_len)
+        return -1;
+    hev_list_del (&self->frame_list, node);
+    pbuf_free (frame->data);
+    hev_free (frame);
+    self->frames--;
+    return 1;
+}
+
+int
+hev_socks5_session_udp_direct_receive (HevSocks5SessionUDP *self,
+    void *scratch, unsigned int capacity, int *output_result)
+{
+    struct iovec span = { scratch, capacity };
+    struct msghdr msg = { 0 };
+    struct pbuf *packet;
+    ssize_t result;
+
+    if (!self->direct_frame_limit || self->base.fd < 0 || !scratch ||
+        !capacity || capacity > 65507 || !output_result)
+        return -1;
+    msg.msg_iov = &span;
+    msg.msg_iovlen = 1;
+    result = recvmsg (self->base.fd, &msg, MSG_DONTWAIT | MSG_TRUNC);
+    if (result < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+            return 0;
+        return -1;
+    }
+    if ((msg.msg_flags & MSG_TRUNC) || (size_t) result > capacity) {
+        *output_result = ERR_BUF;
+        return 1;
+    }
+    packet = pbuf_alloc_reference (scratch, result, PBUF_REF);
+    if (!packet) {
+        *output_result = ERR_MEM;
+        return 1;
+    }
+    hev_task_mutex_lock (self->mutex);
+    *output_result = udp_sendfrom (self->pcb, packet, &self->pcb->local_ip,
+                                   self->pcb->local_port);
+    hev_task_mutex_unlock (self->mutex);
+    pbuf_free (packet);
+    return 1;
+}
+
+HevSocks5SessionUDP *
 hev_socks5_session_udp_new (struct udp_pcb *pcb, HevTaskMutex *mutex)
 {
     HevSocks5SessionUDP *self;
