+/* First wake changes WAITING to RUNNING. Later notifications must not replace
+ * its origin or ready timestamp. Generic wakeups retain OTHER. */
+enum { HEV_TASK_WAKE_CONTINUE, HEV_TASK_WAKE_IO, HEV_TASK_WAKE_ACK,
+       HEV_TASK_WAKE_RECV, HEV_TASK_WAKE_POLL, HEV_TASK_WAKE_TIMER,
+       HEV_TASK_WAKE_OTHER, HEV_TASK_WAKE_START };
+static inline void hev_task_diagnostic_origin (HevTask *task, unsigned int origin)
+{
+#ifdef SAKAMOTO_PRODUCT_VPN_TCP_PROGRESS_EXPERIMENT
+    if (task && task->diagnostic_enabled && task->state == HEV_TASK_WAITING)
+        task->diagnostic_origin = origin;
+#else
+    (void)task; (void)origin;
+#endif
+}
+
 extern void hev_task_execute (HevTask *self, void *executer);
 
