+unsigned int
+hev_task_system_step (unsigned int budget, unsigned int max_us)
+{
+    HevTaskSystemContext *ctx = hev_task_system_get_context ();
+    struct timespec now;
+    if (!ctx || ctx->current_task || ctx->external_active || !budget || !max_us)
+        return 0;
+    clock_gettime (CLOCK_MONOTONIC, &now);
+    ctx->external_active = 1;
+    ctx->external_budget = budget;
+    ctx->external_quanta = 0;
+    ctx->external_events_more = 0;
+    ctx->external_deadline_ns = (uint64_t)now.tv_sec * 1000000000ULL
+        + now.tv_nsec + (uint64_t)max_us * 1000;
+    hev_task_system_schedule (HEV_TASK_RUN_SCHEDULER);
+    ctx->external_active = 0;
+    return ctx->external_quanta;
+}
