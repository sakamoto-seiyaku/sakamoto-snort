+static err_t
+tcp_poll_handler (void *arg, struct tcp_pcb *pcb)
+{
+    HevSocks5SessionTCP *self = arg;
+    (void)pcb;
+    hev_task_wakeup (self->data.task);
+    return ERR_OK;
+}
+
 HevSocks5SessionTCP *
+hev_socks5_session_tcp_direct_new (struct tcp_pcb *pcb, HevTaskMutex *mutex,
+                                  unsigned int buffer_bytes)
+{
+    if (!pcb || !mutex || !buffer_bytes || buffer_bytes > 65535)
+        return NULL;
+    HevSocks5SessionTCP *self = hev_malloc0 (sizeof (*self));
+    if (!self)
+        return NULL;
+    /* The real client/session inheritance still owns the descriptor. Direct
+     * neither constructs a SOCKS address nor reads a global tunnel config. */
+    if (hev_socks5_client_construct (HEV_SOCKS5_CLIENT (self), HEV_SOCKS5_TYPE_TCP) < 0) {
+        hev_free (self);
+        return NULL;
+    }
+    self->buffer = hev_malloc0 (sizeof (*self->buffer) + buffer_bytes);
+    if (!self->buffer) {
+        hev_free (self);
+        return NULL;
+    }
+    self->buffer->max_size = buffer_bytes;
+    self->direct = 1;
+    HEV_OBJECT (self)->klass = HEV_SOCKS5_SESSION_TCP_TYPE;
+    self->pcb = pcb;
+    self->mutex = mutex;
+    self->data.self = self;
+    tcp_arg (pcb, self);
+    tcp_recv (pcb, tcp_recv_handler);
+    tcp_sent (pcb, tcp_sent_handler);
+    tcp_err (pcb, tcp_err_handler);
+    tcp_poll (pcb, tcp_poll_handler, 2);
+    return self;
+}
+
+int hev_socks5_session_tcp_direct_send (HevSocks5SessionTCP *self)
+{ return tcp_splice_f (self); }
+int hev_socks5_session_tcp_direct_receive (HevSocks5SessionTCP *self)
+{ return tcp_splice_b (self); }
+
+void hev_socks5_session_tcp_direct_detach (HevSocks5SessionTCP *self)
+{
+    /* Graceful FIN state continues in lwIP. Its ext-arg retains the owner's
+     * minimal return facts until actual PCB destruction, not this task stack. */
+    if (self->pcb) {
+        tcp_arg (self->pcb, NULL);
+        tcp_recv (self->pcb, NULL);
+        tcp_sent (self->pcb, NULL);
+        tcp_err (self->pcb, NULL);
+        tcp_poll (self->pcb, NULL, 0);
+        self->pcb = NULL;
+    }
+}
