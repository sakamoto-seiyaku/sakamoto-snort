+/* External TUN ingress is a transparent gateway: its destination is the
+ * original remote address, not the synthetic owner netif address.  Keep this
+ * opt-in so controlled/local owner contexts retain strict destination checks. */
+void lwip_owner_context_set_accept_nonlocal(lwip_owner_context_t *context,
+                                            int enabled);
+int lwip_owner_context_accept_nonlocal(const lwip_owner_context_t *context);
+/* External transparent-ingress mode additionally permits the gateway's
+ * wildcard TCP listener and explicitly marked UDP listener to match arbitrary
+ * original destination ports. */
+void lwip_owner_context_set_external_ingress(lwip_owner_context_t *context,
+                                             int enabled);
+int lwip_owner_context_external_ingress(
+    const lwip_owner_context_t *context);
+void lwip_owner_context_set_external_udp_listener(
+    lwip_owner_context_t *context, struct udp_pcb *listener);
+struct udp_pcb *lwip_owner_context_external_udp_listener(
+    const lwip_owner_context_t *context);
+void lwip_owner_context_set_current_udp_dest_port(
+    lwip_owner_context_t *context, uint16_t port);
+uint16_t lwip_owner_context_current_udp_dest_port(
+    const lwip_owner_context_t *context);
+const ip_addr_t *lwip_owner_context_current_ip_dest(
+    const lwip_owner_context_t *context);
