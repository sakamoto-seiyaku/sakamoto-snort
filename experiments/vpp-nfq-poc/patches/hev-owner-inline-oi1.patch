+        goto failed;
+    initialized = 1;
+
+    hev_socks5_owner_config_default (&config);
+    config.identity = 0x01f10001U;
+    config.packet_credit_limit = 4;
+    config.inflight_pbuf_credit_limit = 4;
+    config.max_session_count = 4;
+    driver->owner = hev_socks5_tunnel_owner_new (&config, NULL);
+    if (!driver->owner)
+        goto failed;
+    driver->owner->lwip = lwip_owner_context_create ();
+    if (!driver->owner->lwip)
+        goto failed;
+    driver->owner->owner_lwip_owned = 0;
+    hev_socks5_tunnel_owner_set_lwip (driver->owner, driver->owner->lwip);
+    if (hev_socks5_tunnel_owner_start (driver->owner) < 0)
+        goto failed;
+    if (local_io_owner_prepare (driver->owner, driver->tun_fds[0]) < 0)
+        goto failed;
+
+    driver->owner->owner_oi_driver = driver;
+    driver->owner->owner_oi_mode = 1;
+    driver->owner->owner_oi_timer_interval_ms = timer_interval_ms;
+    driver->owner->owner_oi_force_runnable = driver->always_runnable;
+    driver->owner->owner_local_task_mode = driver->always_runnable;
+    driver->original_output = driver->owner->owner_netif->output;
+    driver->original_output_ip6 = driver->owner->owner_netif->output_ip6;
+    driver->owner->owner_netif->output = sakamoto_oi_netif_output_v4;
+    driver->owner->owner_netif->output_ip6 = sakamoto_oi_netif_output_v6;
+    lwip_owner_context_set_output_data (driver->owner->lwip, driver);
