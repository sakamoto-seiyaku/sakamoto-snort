+    if (driver->wait_cancel_fds[0] >= 0)
+        close (driver->wait_cancel_fds[0]);
+    if (driver->wait_cancel_fds[1] >= 0)
+        close (driver->wait_cancel_fds[1]);
+    if (initialized)
+        hev_task_system_fini ();
+    pthread_mutex_destroy (&driver->wait_lock);
+    free (driver);
+    return NULL;
+}
+
+int
+hev_sakamoto_owner_inline_submit (HevSakamotoOwnerInlineDriver *driver,
+                                  const void *packet, size_t length)
+{
+    if (!sakamoto_oi_on_owner_thread (driver) || !packet || !length ||
+        !driver->initialized || driver->finished || driver->stop_requested)
+        return -1;
+    return send (driver->tun_fds[1], packet, length, 0) == (ssize_t) length
+               ? 0
+               : -1;
+}
+
+int
+hev_sakamoto_owner_inline_drive (HevSakamotoOwnerInlineDriver *driver,
+                                 uint32_t wake_cause,
+                                 uint32_t quantum_budget,
+                                 uint64_t wall_deadline_ns,
+                                 HevSakamotoOwnerInlineResult *result)
+{
+    HevTaskSystemDriverBudget budget;
+    HevTaskSystemDriverResult scheduler;
+    uint64_t started;
+    int status;
+
+    if (result)
+        memset (result, 0, sizeof (*result));
+    if (!driver || !result || !driver->initialized || driver->finished ||
+        !quantum_budget || quantum_budget > 1024 ||
+        !sakamoto_oi_on_owner_thread (driver))
+        return -1;
+    started = sakamoto_oi_now_ns ();
+    if (wall_deadline_ns && started >= wall_deadline_ns) {
+        driver->fault_reason = SAKAMOTO_OI_FAULT_WALL_DEADLINE;
+        result->status = HEV_SAKAMOTO_OI_FAULT;
+        result->fault_reason = driver->fault_reason;
+        return -1;
+    }
+    /* The POC fixes one scheduler quantum per VPP invocation.  The caller's
+     * budget is still validated, but never permits an unbounded loop. */
+    budget.max_quanta = 1;
+    memset (&scheduler, 0, sizeof (scheduler));
+    status = hev_task_system_driver_step (&budget, &scheduler);
+    (void) wake_cause;
+    if (status < 0) {
+        driver->fault_reason = SAKAMOTO_OI_FAULT_DRIVER;
+        sakamoto_oi_fill_result (driver, &scheduler, result);
+        result->status = HEV_SAKAMOTO_OI_FAULT;
+        return -1;
+    }
+    sakamoto_oi_fill_result (driver, &scheduler, result);
+    if (wall_deadline_ns && sakamoto_oi_now_ns () > wall_deadline_ns) {
+        driver->fault_reason = SAKAMOTO_OI_FAULT_WALL_DEADLINE;
+        result->status = HEV_SAKAMOTO_OI_FAULT;
+        result->fault_reason = driver->fault_reason;
+        return -1;
+    }
+    if (!scheduler.total_task_count) {
+        result->status = HEV_SAKAMOTO_OI_STOPPED;
+        result->work_remaining = 0;
+    } else if (scheduler.running_task_count) {
+        result->status = HEV_SAKAMOTO_OI_RUNNABLE;
+        result->work_remaining = 1;
+    } else {
+        result->status = HEV_SAKAMOTO_OI_WAITING;
+        result->work_remaining = 0;
+    }
+    return 0;
+}
+
+int
+hev_sakamoto_owner_inline_arm_wait (HevSakamotoOwnerInlineDriver *driver,
+                                    int wake_sink_fd, uint64_t generation,
+                                    uint64_t sequence)
+{
+    if (!sakamoto_oi_on_owner_thread (driver) || wake_sink_fd < 0 ||
+        !driver->initialized || driver->finished)
+        return -1;
+    sakamoto_oi_wait_cancel (driver);
+    pthread_mutex_lock (&driver->wait_lock);
+    driver->wait_sink_fd = wake_sink_fd;
+    driver->wait_generation = generation;
+    driver->wait_sequence = sequence;
+    driver->wait_timeout_ms = driver->timer_interval_ms > 0
+                                  ? driver->timer_interval_ms
+                                  : -1;
+    if (pthread_create (&driver->wait_thread, NULL, sakamoto_oi_wait_thread,
+                        driver) != 0) {
+        pthread_mutex_unlock (&driver->wait_lock);
+        driver->fault_reason = SAKAMOTO_OI_FAULT_WAIT;
+        return -1;
+    }
+    driver->wait_thread_valid = 1;
+    pthread_mutex_unlock (&driver->wait_lock);
+    return 0;
+}
+
+int
+hev_sakamoto_owner_inline_schedule_fd (HevSakamotoOwnerInlineDriver *driver,
+                                       const void *packet, size_t length,
+                                       uint32_t delay_ms)
+{
+    SakamotoOISourceArgs *args;
+
+    if (!sakamoto_oi_on_owner_thread (driver) || !packet || !length ||
+        !driver->initialized || driver->finished ||
+        driver->source_thread_valid)
+        return -1;
+    args = calloc (1, sizeof (*args));
+    if (!args)
+        return -1;
+    args->packet = malloc (length);
+    if (!args->packet) {
+        free (args);
+        return -1;
+    }
+    memcpy (args->packet, packet, length);
+    args->driver = driver;
+    args->length = length;
+    args->delay_ms = delay_ms;
+    if (pthread_create (&driver->source_thread, NULL,
+                        sakamoto_oi_source_thread, args) != 0) {
+        free (args->packet);
+        free (args);
+        return -1;
+    }
+    driver->source_thread_valid = 1;
+    fprintf (stderr, "sakamoto_oi stage=fd-scheduled delay_ms=%u fd=%d\n",
+             delay_ms, driver->tun_fds[1]);
+    return 0;
+}
+
+typedef struct
+{
+    HevSakamotoOwnerInlineDriver *driver;
+} SakamotoOIForeignProbeArgs;
+
+static void *
+sakamoto_oi_foreign_probe_thread (void *data)
+{
+    SakamotoOIForeignProbeArgs *args = data;
+    HevSakamotoOwnerInlineResult result;
+    uint64_t deadline = sakamoto_oi_now_ns () + 1000000ULL;
+    (void) hev_sakamoto_owner_inline_drive (args->driver,
+                                            HEV_SAKAMOTO_OI_WAKE_CONTROL,
+                                            1, deadline, &result);
+    return NULL;
+}
+
+int
+hev_sakamoto_owner_inline_foreign_probe (
+    HevSakamotoOwnerInlineDriver *driver)
+{
+    SakamotoOIForeignProbeArgs args;
+    pthread_t thread;
+
+    if (!sakamoto_oi_on_owner_thread (driver))
+        return -1;
+    args.driver = driver;
+    if (pthread_create (&thread, NULL, sakamoto_oi_foreign_probe_thread,
+                        &args) != 0)
+        return -1;
+    (void) pthread_join (thread, NULL);
+    return driver->foreign_thread_rejections ? 0 : -1;
+}
+
+int
+hev_sakamoto_owner_inline_request_stop (
+    HevSakamotoOwnerInlineDriver *driver)
+{
+    if (!sakamoto_oi_on_owner_thread (driver) || !driver->initialized ||
+        driver->finished)
+        return -1;
+    driver->stop_requested = 1;
+    return local_task_signal (driver->owner);
+}
+
+int
+hev_sakamoto_owner_inline_quiesce (HevSakamotoOwnerInlineDriver *driver,
+                                   uint64_t generation,
+                                   HevSakamotoOwnerInlineResult *result)
+{
+    HevTaskSystemDriverBudget budget = { .max_quanta = 1 };
+    HevTaskSystemDriverResult scheduler;
+    uint32_t guard;
+    int stopped = 0;
+    int residue;
+    lwip_owner_context_t *lwip;
+
+    if (result)
+        memset (result, 0, sizeof (*result));
+    if (!sakamoto_oi_on_owner_thread (driver) || !driver->initialized ||
+        driver->finished)
+        return -1;
+    sakamoto_oi_wait_cancel (driver);
+    if (driver->source_thread_valid) {
+        (void) pthread_join (driver->source_thread, NULL);
+        driver->source_thread_valid = 0;
+    }
+    if (!driver->stop_requested)
+        driver->stop_requested = 1;
+    (void) local_task_signal (driver->owner);
+    memset (&scheduler, 0, sizeof (scheduler));
+    for (guard = 0; guard < 512; guard++) {
+        if (hev_task_system_driver_step (&budget, &scheduler) < 0)
+            break;
+        if (!scheduler.total_task_count) {
+            stopped = 1;
+            break;
+        }
+    }
+    residue = !stopped || scheduler.total_task_count != 0;
+    if (result) {
+        sakamoto_oi_fill_result (driver, &scheduler, result);
+        result->generation = generation;
+        result->status = stopped ? HEV_SAKAMOTO_OI_STOPPED
+                                 : HEV_SAKAMOTO_OI_FAULT;
+        result->task_residue = scheduler.total_task_count;
+        /* fd_residue is filled after local_io_owner_cleanup below so the
+         * result describes post-quiesce state, not the still-live adapter
+         * socket while the final tasks are being torn down. */
+        result->fd_residue = 0;
+        result->fault_reason = stopped ? 0 : SAKAMOTO_OI_FAULT_QUIESCE;
+    }
+
+    if (driver->udp_listener && driver->owner->lwip)
+        udp_remove_ctx (driver->owner->lwip, driver->udp_listener);
+    driver->udp_listener = NULL;
+    lwip = driver->owner->lwip;
+    driver->owner->owner_oi_mode = 0;
+    driver->owner->owner_oi_timer_interval_ms = 0;
+    driver->owner->owner_oi_force_runnable = 0;
+    driver->owner->owner_oi_driver = NULL;
+    lwip_owner_context_set_output_data (driver->owner->lwip, driver->owner);
+    if (driver->owner->owner_netif) {
+        driver->owner->owner_netif->output = driver->original_output;
+        driver->owner->owner_netif->output_ip6 = driver->original_output_ip6;
+    }
+    local_io_owner_cleanup (driver->owner);
+    if (result) {
+        result->fd_residue = driver->owner->owner_tun_fd >= 0 ? 1 : 0;
+        result->timer_residue =
+            driver->owner->owner_task_lwip_timer ? 1 : 0;
+        result->credit_residue = 0;
+        for (int i = 0; i < HEV_SOCKS5_OWNER_CREDIT_COUNT; i++)
+            result->credit_residue += driver->owner->credit_used[i];
+    }
+    driver->owner->owner_run = 0;
+    hev_socks5_tunnel_owner_free (driver->owner);
+    if (lwip)
+        lwip_owner_context_destroy (lwip);
+    driver->owner = NULL;
+    close (driver->tun_fds[0]);
+    close (driver->tun_fds[1]);
+    close (driver->wait_cancel_fds[0]);
+    close (driver->wait_cancel_fds[1]);
+    driver->finished = 1;
+    hev_task_system_fini ();
+    pthread_mutex_destroy (&driver->wait_lock);
+    free (driver);
+    return residue ? -1 : (stopped ? 0 : -1);
+}
