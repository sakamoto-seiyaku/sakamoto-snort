+/* ------------------------------------------------------------------------- */
+/* OI-1 owner-inline scheduler/wakeup POC                                   */
+
+enum
+{
+    SAKAMOTO_OI_FAULT_FOREIGN_THREAD = 1,
+    SAKAMOTO_OI_FAULT_DRIVER = 2,
+    SAKAMOTO_OI_FAULT_WALL_DEADLINE = 3,
+    SAKAMOTO_OI_FAULT_WAIT = 4,
+    SAKAMOTO_OI_FAULT_QUIESCE = 5,
+};
+
+static err_t
+sakamoto_oi_netif_output_v4 (struct netif *netif, struct pbuf *p,
+                              const ip4_addr_t *destination)
+{
+    HevSakamotoOwnerInlineDriver *driver;
+    lwip_owner_context_t *lwip;
+    (void) destination;
+
+    lwip = lwip_owner_context_from_netif (netif);
+    driver = lwip ? lwip_owner_context_output_data (lwip) : NULL;
+    if (!driver || !p)
+        return ERR_ARG;
+    sakamoto_oi_note_callback (driver->owner, 0);
+    driver->output_packets++;
+    return ERR_OK;
+}
+
+static err_t
+sakamoto_oi_netif_output_v6 (struct netif *netif, struct pbuf *p,
+                             const ip6_addr_t *destination)
+{
+    return sakamoto_oi_netif_output_v4 (netif, p,
+                                        (const ip4_addr_t *) destination);
+}
+
+static void
+sakamoto_oi_udp_recv (void *arg, struct udp_pcb *pcb, struct pbuf *p,
+                      const ip_addr_t *address, u16_t port)
+{
+    HevSakamotoOwnerInlineDriver *driver = arg;
+    err_t result;
+
+    if (!driver || !driver->owner || !p)
+        return;
+    sakamoto_oi_note_callback (driver->owner, 0);
+    driver->input_packets++;
+    result = udp_sendto_ctx (driver->owner->lwip, pcb, p, address, port);
+    if (result != ERR_OK)
+        driver->fault_reason = SAKAMOTO_OI_FAULT_DRIVER;
+    lwip_owner_context_pbuf_free (driver->owner->lwip, p);
+}
+
+static void
+sakamoto_oi_fill_result (HevSakamotoOwnerInlineDriver *driver,
+                         const HevTaskSystemDriverResult *scheduler,
+                         HevSakamotoOwnerInlineResult *result)
+{
+    memset (result, 0, sizeof (*result));
+    result->status = HEV_SAKAMOTO_OI_ERROR;
+    result->quanta = scheduler ? scheduler->quanta : 0;
+    result->total_task_count = scheduler ? scheduler->total_task_count : 0;
+    result->running_task_count =
+        scheduler ? scheduler->running_task_count : 0;
+    result->next_timeout_ms = scheduler ? scheduler->next_timeout_ms : -1;
+    result->generation = driver->generation;
+    result->wake_sequence = driver->wake_sequence;
+    result->input_packets = driver->input_packets;
+    result->output_packets = driver->output_packets;
+    result->timer_callbacks = driver->timer_callbacks;
+    result->callback_count = driver->callback_count;
+    result->foreign_callback_count = driver->foreign_callback_count;
+    result->bound_pthread = driver->thread_bound
+                                ? (uint64_t) (uintptr_t) driver->bound_thread
+                                : 0;
+    result->wait_pthread = driver->wait_thread_valid
+                               ? (uint64_t) (uintptr_t) driver->wait_thread
+                               : 0;
+    result->wait_publishes = driver->wait_publishes;
+    result->wait_callback_count = driver->wait_callback_count;
+    result->foreign_thread_attempts = driver->foreign_thread_attempts;
+    result->foreign_thread_rejections = driver->foreign_thread_rejections;
+    result->fault_reason = driver->fault_reason;
+}
+
+static int
+sakamoto_oi_on_owner_thread (HevSakamotoOwnerInlineDriver *driver)
+{
+    if (!driver || !driver->thread_bound ||
+        !pthread_equal (driver->bound_thread, pthread_self ())) {
+        if (driver) {
+            driver->foreign_thread_attempts++;
+            driver->foreign_thread_rejections++;
+            driver->fault_reason = SAKAMOTO_OI_FAULT_FOREIGN_THREAD;
+        }
+        return 0;
+    }
+    return 1;
+}
+
+static void
+sakamoto_oi_wait_cancel (HevSakamotoOwnerInlineDriver *driver)
+{
+    int value = 1;
+    int join = 0;
+    pthread_t thread;
+
+    if (!driver)
+        return;
+    pthread_mutex_lock (&driver->wait_lock);
+    if (driver->wait_thread_valid) {
+        thread = driver->wait_thread;
+        join = 1;
+        if (driver->wait_cancel_fds[1] >= 0)
+            (void) write (driver->wait_cancel_fds[1], &value, sizeof (value));
+    }
+    pthread_mutex_unlock (&driver->wait_lock);
+    if (join) {
+        (void) pthread_join (thread, NULL);
+        pthread_mutex_lock (&driver->wait_lock);
+        driver->wait_thread_valid = 0;
+        pthread_mutex_unlock (&driver->wait_lock);
+        /* A canceled helper leaves its byte in the shared cancel pipe.  A
+         * subsequent arm must drain that byte or it will immediately treat
+         * the next wait as canceled and can miss a real FD readiness wake. */
+        if (driver->wait_cancel_fds[0] >= 0) {
+            int discarded;
+            while (read (driver->wait_cancel_fds[0], &discarded,
+                         sizeof (discarded)) == (ssize_t) sizeof (discarded))
+                ;
+        }
+    }
+}
+
+static void *
+sakamoto_oi_wait_thread (void *data)
+{
+    HevSakamotoOwnerInlineDriver *driver = data;
+    struct pollfd fds[2];
+    HevSakamotoOwnerInlineWakeToken token;
+    int timeout;
+    int result;
+    uint32_t cause;
+
+    memset (&token, 0, sizeof (token));
+    pthread_mutex_lock (&driver->wait_lock);
+    timeout = driver->wait_timeout_ms;
+    token.generation = driver->wait_generation;
+    token.sequence = driver->wait_sequence;
+    pthread_mutex_unlock (&driver->wait_lock);
+
+    fds[0].fd = driver->wait_cancel_fds[0];
+    fds[0].events = POLLIN;
+    fds[0].revents = 0;
+    fds[1].fd = driver->tun_fds[0];
+    fds[1].events = POLLIN;
+    fds[1].revents = 0;
+
+    do {
+        result = poll (fds, 2, timeout);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        driver->fault_reason = SAKAMOTO_OI_FAULT_WAIT;
+        return NULL;
+    }
+    if (fds[0].revents & POLLIN)
+        return NULL;
+
+    cause = result == 0 ? HEV_SAKAMOTO_OI_WAKE_TIMER : 0;
+    if (fds[1].revents & (POLLIN | POLLERR | POLLHUP))
+        cause = cause ? HEV_SAKAMOTO_OI_WAKE_MIXED
+                      : HEV_SAKAMOTO_OI_WAKE_FD;
+    if (!cause)
+        cause = HEV_SAKAMOTO_OI_WAKE_CONTROL;
+    fprintf (stderr,
+             "sakamoto_oi stage=wait-observed result=%d revents=%x/%x "
+             "cause=%u generation=%llu sequence=%llu\n",
+             result, fds[0].revents, fds[1].revents, cause,
+             (unsigned long long) token.generation,
+             (unsigned long long) token.sequence);
+    token.cause = cause;
+    token.reserved = 0;
+    driver->wait_pthread = (uint64_t) (uintptr_t) pthread_self ();
+    if (driver->wait_sink_fd < 0 ||
+        write (driver->wait_sink_fd, &token, sizeof (token)) !=
+            (ssize_t) sizeof (token)) {
+        driver->fault_reason = SAKAMOTO_OI_FAULT_WAIT;
+        return NULL;
+    }
+    driver->wait_publishes++;
+    /* This thread only observed readiness/deadline and published an opaque
+     * token.  It deliberately does not call a HEV or lwIP entry point. */
+    return NULL;
+}
+
+typedef struct
+{
+    HevSakamotoOwnerInlineDriver *driver;
+    uint8_t *packet;
+    size_t length;
+    uint32_t delay_ms;
+} SakamotoOISourceArgs;
+
+static void *
+sakamoto_oi_source_thread (void *data)
+{
+    SakamotoOISourceArgs *args = data;
+    struct timespec delay;
+
+    delay.tv_sec = args->delay_ms / 1000U;
+    delay.tv_nsec = (long) (args->delay_ms % 1000U) * 1000000L;
+    while (nanosleep (&delay, &delay) < 0 && errno == EINTR)
+        ;
+    if (!args->driver->stop_requested && !args->driver->finished) {
+        ssize_t sent = send (args->driver->tun_fds[1], args->packet,
+                             args->length, 0);
+        fprintf (stderr,
+                 "sakamoto_oi stage=fd-source sent=%zd length=%zu "
+                 "stop=%d finished=%d fd=%d\n",
+                 sent, args->length, args->driver->stop_requested,
+                 args->driver->finished, args->driver->tun_fds[1]);
+    } else {
+        fprintf (stderr,
+                 "sakamoto_oi stage=fd-source skipped stop=%d finished=%d\n",
+                 args->driver->stop_requested, args->driver->finished);
+    }
+    free (args->packet);
+    free (args);
+    return NULL;
+}
+
+HevSakamotoOwnerInlineDriver *
+hev_sakamoto_owner_inline_new (int timer_interval_ms, int always_runnable)
+{
+    HevSakamotoOwnerInlineDriver *driver;
+    HevSocks5OwnerConfig config;
+    ip_addr_t local_address;
+    int initialized = 0;
+
+    if (timer_interval_ms < 0 || timer_interval_ms > 1000)
+        return NULL;
+    driver = calloc (1, sizeof (*driver));
+    if (!driver)
+        return NULL;
+    driver->tun_fds[0] = driver->tun_fds[1] = -1;
+    driver->wait_cancel_fds[0] = driver->wait_cancel_fds[1] = -1;
+    driver->wait_sink_fd = -1;
+    driver->timer_interval_ms = timer_interval_ms;
+    driver->always_runnable = always_runnable != 0;
+    driver->generation = 1;
+    if (pthread_mutex_init (&driver->wait_lock, NULL) != 0)
+        goto failed;
+    if (pipe (driver->wait_cancel_fds) < 0 ||
+        socketpair (PF_LOCAL, SOCK_DGRAM, 0, driver->tun_fds) < 0)
+        goto failed;
+    {
+        int flags = fcntl (driver->wait_cancel_fds[0], F_GETFL, 0);
+        if (flags >= 0)
+            (void) fcntl (driver->wait_cancel_fds[0], F_SETFL,
+                          flags | O_NONBLOCK);
+    }
