+static uint64_t
+sakamoto_oi_now_ns (void)
+{
+    struct timespec ts;
+    if (clock_gettime (CLOCK_MONOTONIC, &ts) < 0)
+        return 0;
+    return (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec;
+}
+
+static void
+sakamoto_oi_note_callback (HevSocks5TunnelOwnerRuntime *owner,
+                           int timer_callback)
+{
+    HevSakamotoOwnerInlineDriver *driver;
+    pthread_t self;
+
+    if (!owner || !owner->owner_oi_mode || !owner->owner_oi_driver)
+        return;
+    driver = owner->owner_oi_driver;
+    self = pthread_self ();
+    driver->callback_count++;
+    if (!driver->thread_bound || !pthread_equal (driver->bound_thread, self))
+        driver->foreign_callback_count++;
+    if (timer_callback)
+        driver->timer_callbacks++;
+}
