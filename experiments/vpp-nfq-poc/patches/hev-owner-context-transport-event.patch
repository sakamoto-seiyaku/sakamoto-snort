+static void
+tcp_transport_event (HevSocks5SessionTCP *self, unsigned int event,
+                     int error)
+{
+    const HevSocks5TcpConnector *connector = self->data.connector;
+
+    /* This callback runs synchronously in the HEV session task.  Under the
+     * external-driver contract that task is driven only by the canonical
+     * FlowStackOwner, so socket outcome state never moves to the readiness
+     * observer thread. */
+    if (connector && connector->transport_event)
+        connector->transport_event (connector->data, self->data.owner,
+                                    self->pcb, event, error);
+}
