+void
+lwip_owner_context_tcp_copy_add(lwip_owner_context_t *context,
+                                uint64_t elapsed_ns, size_t bytes)
+{
+  if (!context)
+    return;
+  context->tcp_copy_ns += elapsed_ns;
+  context->tcp_copy_bytes += bytes;
+}
+
+void
+lwip_owner_context_tcp_copy_enable(lwip_owner_context_t *context, int enabled)
+{
+  if (context)
+    context->tcp_copy_timing_enabled = enabled != 0;
+}
+
+int
+lwip_owner_context_tcp_copy_enabled(const lwip_owner_context_t *context)
+{
+  return context && context->tcp_copy_timing_enabled;
+}
+
+void
+lwip_owner_context_tcp_copy_metrics(const lwip_owner_context_t *context,
+                                    uint64_t *copy_ns, uint64_t *copy_bytes)
+{
+  if (copy_ns)
+    *copy_ns = context ? context->tcp_copy_ns : 0;
+  if (copy_bytes)
+    *copy_bytes = context ? context->tcp_copy_bytes : 0;
+}
