+    uint64_t _copy_started = _copy_enabled ? lwip_owner_tcp_copy_now_ns() : 0; \
+    TCP_DATA_COPY2(dst, src, len, chksum, chksum_swapped);                \
+    if (_copy_enabled)                                                     \
+      lwip_owner_context_tcp_copy_add(                                    \
