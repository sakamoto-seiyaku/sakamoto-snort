+static void
+tcp_propagate_reset (HevSocks5SessionTCP *self)
+{
+    if (!self->data.lwip || self->pcb_reset_attempted)
+        return;
+    hev_task_mutex_lock (self->mutex);
+    if (!self->pcb_reset_attempted) {
+        self->pcb_reset_attempted = 1;
+        if (self->pcb &&
+            tcp_send_reset_ctx (self->data.lwip, self->pcb) == ERR_OK)
+            self->pcb_reset_sent = 1;
+    }
+    hev_task_mutex_unlock (self->mutex);
+}
