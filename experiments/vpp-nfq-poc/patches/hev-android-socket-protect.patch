 {
@@ -53,6 +56,22 @@ hev_socks5_task_io_yielder (HevTaskYieldType type, void *data)
     return 0;
 }
 
+void
+hev_socks5_set_socket_protect (HevSocks5SocketProtectFunc func, void *data)
+{
+    socket_protect_func = func;
+    socket_protect_data = data;
+}
+
+int
+hev_socks5_protect_socket (int fd)
+{
+    if (!socket_protect_func)
+        return 0;
+
+    return socket_protect_func (fd, socket_protect_data);
+}
