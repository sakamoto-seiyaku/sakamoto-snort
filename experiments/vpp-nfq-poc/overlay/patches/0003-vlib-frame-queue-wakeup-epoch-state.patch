+  VLIB_WAKE_PHASE_PREPARING_TO_SLEEP = 1,
+  VLIB_WAKE_PHASE_SLEEPING = 2,
+  VLIB_WAKE_PHASE_NOTIFIED = 3,
+  VLIB_WAKE_PHASE_DRAINING = 4,
+  /* Internal refinement of model NOTIFIED while write_required is true. */
+  VLIB_WAKE_PHASE_NOTIFYING = 5,
+} vlib_wake_phase_t;
+
+typedef enum
+{
+  VLIB_WAKE_FAULT_NONE = 0,
+  VLIB_WAKE_FAULT_EBADF = 1,
+  VLIB_WAKE_FAULT_EINVAL = 2,
+  VLIB_WAKE_FAULT_SHORT_WRITE = 3,
+  VLIB_WAKE_FAULT_EINTR_EXHAUSTED = 4,
+  VLIB_WAKE_FAULT_EPOCH_EXHAUSTED = 5,
+  VLIB_WAKE_FAULT_WRITE_ERROR = 6,
+  VLIB_WAKE_FAULT_CAS_EXHAUSTED = 7,
+  VLIB_WAKE_FAULT_STATE_ERROR = 8,
+} vlib_wake_fault_t;
+
+typedef enum
+{
+  VLIB_WAKE_INJECT_OFF = 0,
+  VLIB_WAKE_INJECT_SUCCESS = 1,
+  VLIB_WAKE_INJECT_EINTR = 2,
+  VLIB_WAKE_INJECT_EAGAIN = 3,
+  VLIB_WAKE_INJECT_EBADF = 4,
+  VLIB_WAKE_INJECT_EINVAL = 5,
+  VLIB_WAKE_INJECT_SHORT = 6,
+} vlib_wake_inject_outcome_t;
+
+#define VLIB_WAKE_PHASE_MASK ((u64) 7)
+#define VLIB_WAKE_EPOCH_MASK (~VLIB_WAKE_PHASE_MASK)
+#define VLIB_WAKE_EPOCH_INCREMENT ((u64) 8)
+#define VLIB_WAKE_CAS_ATTEMPTS 64
+#define VLIB_WAKE_POC_EXIT_STATUS 86
+#define VLIB_WAKE_INJECT_OUTCOME_MASK ((u32) 0xff)
+#define VLIB_WAKE_INJECT_REMAINING_SHIFT 8
+#define VLIB_WAKE_INJECT_PLAN(outcome, remaining)                              \
+  ((u32) (outcome) | ((u32) (remaining) << VLIB_WAKE_INJECT_REMAINING_SHIFT))
+
+static_always_inline vlib_wake_phase_t
+vlib_wakeup_epoch_phase (u64 state)
+{
+  return (vlib_wake_phase_t) (state & VLIB_WAKE_PHASE_MASK);
+}
+
+static_always_inline int
+vlib_thread_is_sleeping (vlib_main_t *vm)
+{
+  u64 state;
+
+  if (vlib_frame_queue_wakeup_mode == 0 ||
+      vlib_frame_queue_wakeup_mode == 3)
+    return __atomic_load_n (&vm->thread_sleeps, __ATOMIC_ACQUIRE) != 0;
+
+  state = __atomic_load_n (&vm->wakeup_epoch_state, __ATOMIC_ACQUIRE);
+
+  return vlib_wakeup_epoch_phase (state) == VLIB_WAKE_PHASE_SLEEPING;
+}
+
+static_always_inline void
+vlib_wakeup_record_fault (vlib_main_t *vm, vlib_wake_fault_t fault)
+{
+  u32 expected = VLIB_WAKE_FAULT_NONE;
+
+  /* The first low-cardinality correctness fault is stable for postmortem. */
+  __atomic_compare_exchange_n (&vm->wakeup_channel_fault, &expected, fault, 0,
+			       __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+  vlib_exit_with_status (vlib_get_first_main (), VLIB_WAKE_POC_EXIT_STATUS);
+}
+
+static_always_inline void
+vlib_wakeup_epoch_set_phase (vlib_main_t *vm, vlib_wake_phase_t phase)
+{
+  u64 state = __atomic_load_n (&vm->wakeup_epoch_state, __ATOMIC_ACQUIRE);
+  u64 desired;
+
+  for (u32 attempt = 0; attempt < VLIB_WAKE_CAS_ATTEMPTS; attempt++)
+    {
+      desired = (state & VLIB_WAKE_EPOCH_MASK) | phase;
+      if (__atomic_compare_exchange_n (&vm->wakeup_epoch_state, &state,
+				       desired, 0, __ATOMIC_ACQ_REL,
+				       __ATOMIC_ACQUIRE))
+	return;
+    }
+
+  vlib_wakeup_record_fault (vm, VLIB_WAKE_FAULT_CAS_EXHAUSTED);
+}
+
+static_always_inline int
+vlib_wakeup_epoch_begin_draining (vlib_main_t *vm)
+{
+  u64 state = __atomic_load_n (&vm->wakeup_epoch_state, __ATOMIC_ACQUIRE);
+  u64 desired;
+
+  for (u32 attempt = 0; attempt < VLIB_WAKE_CAS_ATTEMPTS; attempt++)
+    {
+      /* Model write_required: the worker cannot retire an active writer. */
+      if (vlib_wakeup_epoch_phase (state) == VLIB_WAKE_PHASE_NOTIFYING)
+	return 0;
+      desired =
+	(state & VLIB_WAKE_EPOCH_MASK) | VLIB_WAKE_PHASE_DRAINING;
+      if (__atomic_compare_exchange_n (&vm->wakeup_epoch_state, &state,
+				       desired, 0, __ATOMIC_ACQ_REL,
+				       __ATOMIC_ACQUIRE))
+	return 1;
+    }
+
+  vlib_wakeup_record_fault (vm, VLIB_WAKE_FAULT_CAS_EXHAUSTED);
+  return 0;
+}
+
+static_always_inline int
+vlib_wakeup_epoch_retire_notifying (vlib_main_t *vm,
+				    vlib_wake_phase_t phase)
+{
+  u64 state = __atomic_load_n (&vm->wakeup_epoch_state, __ATOMIC_ACQUIRE);
+  u64 desired;
+
+  for (u32 attempt = 0; attempt < VLIB_WAKE_CAS_ATTEMPTS; attempt++)
+    {
+      if (PREDICT_FALSE (vlib_wakeup_epoch_phase (state) !=
+			 VLIB_WAKE_PHASE_NOTIFYING))
+	{
+	  vlib_wakeup_record_fault (vm, VLIB_WAKE_FAULT_STATE_ERROR);
+	  return 0;
+	}
+      desired = (state & VLIB_WAKE_EPOCH_MASK) | phase;
+      if (__atomic_compare_exchange_n (&vm->wakeup_epoch_state, &state,
+				       desired, 0, __ATOMIC_ACQ_REL,
+				       __ATOMIC_ACQUIRE))
+	return 1;
+    }
+
+  vlib_wakeup_record_fault (vm, VLIB_WAKE_FAULT_CAS_EXHAUSTED);
+  return 0;
+}
+
+static_always_inline ssize_t
+vlib_wakeup_eventfd_write (vlib_main_t *vm, u64 *val)
+{
+#if VLIB_WAKE_FAULT_INJECTION
+  u32 plan;
+  u32 outcome = VLIB_WAKE_INJECT_OFF;
+
+  /* Barrier direct wakes are control-plane progress, never fault subjects. */
+  if (__atomic_load_n (vlib_worker_threads->wait_at_barrier,
+		       __ATOMIC_ACQUIRE))
+    return write (vm->wakeup_fd, val, sizeof (*val));
+
+  plan = __atomic_load_n (&vm->wakeup_inject_plan, __ATOMIC_ACQUIRE);
+
+  for (u32 attempt = 0; attempt < VLIB_WAKE_CAS_ATTEMPTS; attempt++)
+    {
+      u32 remaining = plan >> VLIB_WAKE_INJECT_REMAINING_SHIFT;
+      u32 desired;
+
+      if (remaining == 0)
+	break;
+      outcome = plan & VLIB_WAKE_INJECT_OUTCOME_MASK;
+      desired = VLIB_WAKE_INJECT_PLAN (outcome, remaining - 1);
+      if (!__atomic_compare_exchange_n (
+	    &vm->wakeup_inject_plan, &plan, desired, 0, __ATOMIC_ACQ_REL,
+	    __ATOMIC_ACQUIRE))
+	continue;
+
+      switch (outcome)
+	{
+	case VLIB_WAKE_INJECT_SUCCESS:
+	  return write (vm->wakeup_fd, val, sizeof (*val));
+	case VLIB_WAKE_INJECT_EINTR:
+	  errno = EINTR;
+	  return -1;
+	case VLIB_WAKE_INJECT_EAGAIN:
+	  {
+	    ssize_t rv = write (vm->wakeup_fd, val, sizeof (*val));
+
+	    /* Injected EAGAIN still means the eventfd is actually readable. */
+	    if (rv == sizeof (*val) || (rv < 0 && errno == EAGAIN))
+	      {
+		errno = EAGAIN;
+		return -1;
+	      }
+	    return rv;
+	  }
+	case VLIB_WAKE_INJECT_EBADF:
+	  errno = EBADF;
+	  return -1;
+	case VLIB_WAKE_INJECT_EINVAL:
+	  errno = EINVAL;
+	  return -1;
+	case VLIB_WAKE_INJECT_SHORT:
+	  return sizeof (u32);
+	default:
+	  return write (vm->wakeup_fd, val, sizeof (*val));
+	}
+    }
+  if (PREDICT_FALSE ((plan >> VLIB_WAKE_INJECT_REMAINING_SHIFT) != 0))
+    {
+      vlib_wakeup_record_fault (vm, VLIB_WAKE_FAULT_CAS_EXHAUSTED);
+      errno = EIO;
+      return -1;
+    }
+#endif
+  return write (vm->wakeup_fd, val, sizeof (*val));
+}
