diff --git a/src/svm/svm_android_file.c b/src/svm/svm_android_file.c
new file mode 100644
index 00000000..215945af
--- /dev/null
+++ b/src/svm/svm_android_file.c
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include "svm_android_file.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+static int
+svm_android_file_component (const char *value, char *dst, size_t dst_size)
+{
+  size_t len;
+
+  if (!value)
+    return 0;
+
+  while (*value == '/')
+    value++;
+  if (*value == '\0' || strcmp (value, ".") == 0 ||
+      strcmp (value, "..") == 0 || strchr (value, '/') ||
+      strchr (value, '\\'))
+    {
+      errno = EINVAL;
+      return -1;
+    }
+
+  len = strlen (value);
+  if (len >= dst_size)
+    {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+  memcpy (dst, value, len + 1);
+  return 1;
+}
+
+int
+svm_android_file_path (char *dst, size_t dst_size,
+		       const char *namespace_name,
+		       const char *region_name)
+{
+  const char *base;
+  char namespace_component[NAME_MAX + 1];
+  char region_component[NAME_MAX + 1];
+  char resolved_base[PATH_MAX];
+  struct stat st;
+  int has_namespace;
+  int n;
+
+  if (!dst || dst_size == 0 || !region_name)
+    {
+      errno = EINVAL;
+      return -1;
+    }
+
+  base = getenv (SVM_ANDROID_FILE_DIR_ENV);
+  if (!base || base[0] != '/')
+    {
+      errno = ENOENT;
+      return -1;
+    }
+  if (stat (base, &st) < 0)
+    return -1;
+  if (!S_ISDIR (st.st_mode))
+    {
+      errno = ENOTDIR;
+      return -1;
+    }
+  if (!realpath (base, resolved_base))
+    return -1;
+
+  has_namespace = svm_android_file_component (
+    namespace_name, namespace_component, sizeof (namespace_component));
+  if (has_namespace < 0)
+    return -1;
+  if (svm_android_file_component (region_name, region_component,
+				  sizeof (region_component)) <= 0)
+    return -1;
+
+  if (has_namespace)
+    n = snprintf (dst, dst_size, "%s/%s-%s", resolved_base,
+		  namespace_component, region_component);
+  else
+    n = snprintf (dst, dst_size, "%s/%s", resolved_base,
+		  region_component);
+  if (n < 0 || (size_t) n >= dst_size)
+    {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+  return 0;
+}
+
+int
+svm_android_file_open (const char *namespace_name,
+		       const char *region_name, int flags, mode_t mode)
+{
+  char path[PATH_MAX];
+  struct stat st;
+  int fd;
+
+  if (svm_android_file_path (path, sizeof (path), namespace_name,
+			     region_name) < 0)
+    return -1;
+
+  if (flags & O_CREAT)
+    fd = open (path, flags | O_CLOEXEC | O_NOFOLLOW, mode);
+  else
+    fd = open (path, flags | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0)
+    return -1;
+
+  if (fstat (fd, &st) < 0)
+    {
+      int saved_errno = errno;
+      close (fd);
+      errno = saved_errno;
+      return -1;
+    }
+  if (!S_ISREG (st.st_mode))
+    {
+      close (fd);
+      errno = EINVAL;
+      return -1;
+    }
+
+  if (flags & O_CREAT)
+    {
+      if (fchmod (fd, S_IRUSR | S_IWUSR) < 0)
+	{
+	  int saved_errno = errno;
+	  close (fd);
+	  unlink (path);
+	  errno = saved_errno;
+	  return -1;
+	}
+    }
+  return fd;
+}
+
+int
+svm_android_file_unlink (const char *namespace_name,
+			 const char *region_name)
+{
+  char path[PATH_MAX];
+
+  if (svm_android_file_path (path, sizeof (path), namespace_name,
+			     region_name) < 0)
+    return -1;
+  return unlink (path);
+}
diff --git a/src/svm/svm_android_file.h b/src/svm/svm_android_file.h
new file mode 100644
index 00000000..53145acc
--- /dev/null
+++ b/src/svm/svm_android_file.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#ifndef included_svm_android_file_h
+#define included_svm_android_file_h
+
+#include <stddef.h>
+#include <sys/types.h>
+
+#define SVM_ANDROID_FILE_DIR_ENV "SAKAMOTO_VPP_SVM_DIR"
+
+/*
+ * Resolve one generation-private SVM region path.  The environment variable
+ * names a directory created for the active generation; both optional
+ * namespace and region names are single, traversal-free path components.
+ */
+int svm_android_file_path (char *dst, size_t dst_size,
+			   const char *namespace_name,
+			   const char *region_name);
+
+/* Open a generation-private regular file with shm_open-equivalent flags. */
+int svm_android_file_open (const char *namespace_name,
+			   const char *region_name, int flags, mode_t mode);
+
+/* Remove one generation-private regular file. */
+int svm_android_file_unlink (const char *namespace_name,
+			     const char *region_name);
+
+#endif /* included_svm_android_file_h */
