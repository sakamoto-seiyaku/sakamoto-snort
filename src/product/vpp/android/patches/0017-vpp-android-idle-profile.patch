--- a/src/vlib/stats/collector.c
+++ b/src/vlib/stats/collector.c
@@ -174,7 +174,12 @@ stat_segment_collector_process (vlib_main_t *vm, vlib_node_runtime_t *rt,
   while (1)
     {
       do_stat_segment_updates (vm, sm);
+#ifdef SAKAMOTO_VPP_ANDROID_IDLE_PROFILE
+      vlib_process_wait_for_event (vm);
+      (void) vlib_process_get_events (vm, 0);
+#else
       vlib_process_suspend (vm, sm->update_interval);
+#endif
     }
   return 0; /* or not */
 }
