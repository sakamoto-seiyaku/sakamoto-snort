diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 926713e1..6b013b4d 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -223,6 +223,15 @@ if(SAKAMOTO_VPP_NO_IPSEC)
   add_compile_definitions(SAKAMOTO_VPP_NO_IPSEC=1)
 endif()
 
+option(SAKAMOTO_VPP_ANDROID_IDLE_PROFILE
+  "Use the accepted event-driven Android VPP idle profile" OFF)
+if(SAKAMOTO_VPP_ANDROID_IDLE_PROFILE)
+  add_compile_definitions(
+    SAKAMOTO_VPP_ANDROID_IDLE_PROFILE=1
+    SAKAMOTO_ANDROID_WORKER_IDLE_IGNORES_RECENT_BARRIER_HOLDOFF=1
+  )
+endif()
+
 include_directories (
 	${CMAKE_SOURCE_DIR}
 	${VPP_BINARY_DIR}
diff --git a/src/vlib/file.c b/src/vlib/file.c
index 286b0d1f..d1b3544a 100644
--- a/src/vlib/file.c
+++ b/src/vlib/file.c
@@ -110,7 +110,11 @@ vlib_file_poll (vlib_main_t *vm)
   struct epoll_event *e, epoll_events[16];
   int n_fds_ready;
   int is_main = (vm->thread_index == 0);
+#ifdef SAKAMOTO_VPP_ANDROID_IDLE_PROFILE
+  int timeout_ms = 0, max_timeout_ms = 1000;
+#else
   int timeout_ms = 0, max_timeout_ms = 10;
+#endif
   u32 ticks;
 
   /*
@@ -133,8 +137,12 @@ vlib_file_poll (vlib_main_t *vm)
   if (vlib_last_vectors_per_main_loop (vm) >= 2)
     goto skip_loops;
 
-  /* at least one node is polling */
-  if (nm->input_node_counts_by_state[VLIB_NODE_STATE_POLLING])
+  /* A cloned worker may sleep when only main-thread input needs polling. */
+  if (nm->input_node_counts_by_state[VLIB_NODE_STATE_POLLING]
+#ifdef SAKAMOTO_VPP_ANDROID_IDLE_PROFILE
+      && is_main
+#endif
+  )
     goto skip_loops;
 
   /* pending APIs in the queue */
@@ -146,9 +154,11 @@ vlib_file_poll (vlib_main_t *vm)
       if (*vlib_worker_threads->wait_at_barrier)
 	goto epoll;
 
+#ifndef SAKAMOTO_ANDROID_WORKER_IDLE_IGNORES_RECENT_BARRIER_HOLDOFF
       if (vlib_get_first_main ()->time_last_barrier_release + 0.5 >=
 	  vlib_time_now (vm))
 	goto skip_loops;
+#endif
     }
 
   /* check for pending interrupts */
diff --git a/src/vlib/stats/collector.c b/src/vlib/stats/collector.c
