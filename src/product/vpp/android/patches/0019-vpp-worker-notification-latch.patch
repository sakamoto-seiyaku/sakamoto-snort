 void
+vlib_thread_wakeup (clib_thread_index_t thread_index)
+{
+  vlib_main_t *vm = vlib_get_main_by_index (thread_index);
+  /* Every publication takes part, even if its syscall is coalesced. */
+  if (__atomic_exchange_n (&vm->wakeup_pending, 1, __ATOMIC_SEQ_CST))
+    return;
+  u64 value = 1;
+  ssize_t rv;
+  do
+    rv = write (vm->wakeup_fd, &value, sizeof (value));
+  while (rv < 0 && errno == EINTR);
+  if (rv != sizeof (value) && !(rv < 0 && errno == EAGAIN))
+    clib_panic ("worker notification failed on thread %u: %d", thread_index, errno);
+}
+
+static void
+vlib_worker_wake_ack (vlib_main_t *vm)
+{
+  u64 value;
+  ssize_t rv;
+  /* One read consumes the normal eventfd counter at this instant. Later
+   * writers can leave readiness behind; LT does not require an unbounded
+   * drain-until-EAGAIN loop while senders continue publishing. */
+  do
+    rv = read (vm->wakeup_fd, &value, sizeof (value));
+  while (rv < 0 && errno == EINTR);
+  if (rv != sizeof (value) && !(rv < 0 && errno == EAGAIN))
+    clib_panic ("worker notification read failed on thread %u: %d", vm->thread_index, errno);
+  __atomic_exchange_n (&vm->wakeup_pending, 0, __ATOMIC_SEQ_CST);
+}
