+	  RTLD_NEXT, "malloc_usable_size");
+      /* A missing libc symbol must not be called through a null pointer. */
+      if (!__malloc_usable_size)
+	{
+	  errno = ENOSYS;
+	  return 0;
+	}
+      return __malloc_usable_size (p);
     }
@@ -252,2 +267,2 @@
-  return clib_mem_size (p);
+  return clib_mem_size ((void *) p);
 }
