--- a/src/vlib/threads.c
+++ b/src/vlib/threads.c
@@ -1379,7 +1379,24 @@
   __atomic_store_n (vlib_worker_threads->wait_at_barrier, 1, __ATOMIC_RELEASE);
 
   for (clib_thread_index_t ti = 1; ti < vlib_get_n_threads (); ti++)
-    vlib_thread_wakeup (ti);
+    {
+#ifdef SAKAMOTO_VPP_ANDROID_IDLE_PROFILE
+      /* A worker may pass its barrier check before publishing thread_sleeps.
+       * The conditional wakeup can then miss it for the full Android idle
+       * second, which is also BARRIER_SYNC_TIMEOUT.  Queue the barrier wake
+       * unconditionally: eventfd retains it across entry into epoll_wait.
+       * Keep the accepted idle timeout and ordinary packet wakeup unchanged.
+       */
+      vlib_main_t *worker_vm = vlib_get_main_by_index (ti);
+      u64 value = 1;
+      ssize_t rv;
+      do
+        rv = write (worker_vm->wakeup_fd, &value, sizeof (value));
+      while (rv < 0 && errno == EINTR);
+#else
+      vlib_thread_wakeup (ti);
+#endif
+    }
 
   while (*vlib_worker_threads->workers_at_barrier != count)
     {
