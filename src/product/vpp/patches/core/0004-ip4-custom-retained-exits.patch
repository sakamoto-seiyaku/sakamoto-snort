+/* Control-only snapshot/flush. The caller quiesces workers before changing
+ * lifetime state; matching the registered custom error slot leaves unrelated
+ * native feature contexts alone. Native locks own their native context pools. */
+u32
+ip4_full_reass_custom_count (u32 error_next_index)
+{
+  ip4_full_reass_main_t *rm = &ip4_full_reass_main;
+  u32 count = 0;
+  ip4_full_reass_per_thread_t *rt;
+  vec_foreach (rt, rm->per_thread_data)
+    {
+      clib_spinlock_lock (&rt->lock);
+      ip4_full_reass_t *reass;
+      pool_foreach (reass, rt->pool)
+        if (reass->error_next_index == error_next_index) count++;
+      clib_spinlock_unlock (&rt->lock);
+    }
+  return count;
+}
+
+u32
+ip4_full_reass_custom_flush (vlib_main_t *vm, u32 error_next_index)
+{
+  ip4_full_reass_main_t *rm = &ip4_full_reass_main;
+  vlib_node_runtime_t *node = vlib_node_get_runtime (
+    vm, ip4_full_reass_node_custom.index);
+  u32 count = 0;
+  ip4_full_reass_per_thread_t *rt;
+  vec_foreach (rt, rm->per_thread_data)
+    {
+      u32 *indices = 0;
+      uword index;
+      clib_spinlock_lock (&rt->lock);
+      pool_foreach_index (index, rt->pool)
+        {
+          ip4_full_reass_t *reass = pool_elt_at_index (rt->pool, index);
+          if (reass->error_next_index == error_next_index)
+            vec_add1 (indices, (u32) index);
+        }
+      u32 *slot;
+      vec_foreach (slot, indices)
+        {
+          ip4_full_reass_t *reass = pool_elt_at_index (rt->pool, *slot);
+          ip4_full_reass_drop_all (vm, node, reass, IP4_ERROR_REASS_TIMEOUT,
+                                   IP4_FULL_REASS_CUSTOM_ERROR_STOP);
+          ip4_full_reass_free (rm, rt, reass);
+          count++;
+        }
+      vec_free (indices);
+      clib_spinlock_unlock (&rt->lock);
+    }
+  return count;
+}
