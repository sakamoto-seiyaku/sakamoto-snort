+  if (vec_len (ordered_worker_cpus))
+    {
+      p = hash_get_mem (tm->thread_registrations_by_name, "workers");
+      if (!p)
+        return clib_error_return (0, "ordered-workers: worker type unavailable");
+      tr = (vlib_thread_registration_t *) p[0];
+      if (tm->main_lcore == ~0 || tm->use_pthreads || tm->cpu_translate ||
+          tm->skip_cores || tr->use_pthreads || tr->coremask)
+        return clib_error_return (
+          0, "ordered-workers: explicit main-core and workers count required; "
+          "corelist/coremask, relative, skip-cores and use-pthreads conflict");
+      if (tr->count != vec_len (ordered_worker_cpus))
+        return clib_error_return (0, "ordered-workers: CPU count must equal workers");
+
+      /* main.c snapshots inherited affinity before narrowing the main thread.
+       * Reading sched_getaffinity here instead would see only main-core. */
+      uword *allowed = os_get_cpu_affinity_bitmap ();
+      uword *online = os_get_online_cpu_core_bitmap ();
+      clib_error_t *error = 0;
+      if (!allowed || !online)
+        error = clib_error_return (0, "ordered-workers: CPU availability unknown");
+      for (u32 i = 0; !error && i <= tr->count; i++)
+        {
+          u32 cpu = i == tr->count ? tm->main_lcore : ordered_worker_cpus[i];
+          if (cpu >= CPU_SETSIZE || !clib_bitmap_get (online, cpu))
+            error = clib_error_return (
+              0, "ordered-workers: CPU %u absent or offline", cpu);
+          else if (!clib_bitmap_get (allowed, cpu))
+            error = clib_error_return (
+              0, "ordered-workers: CPU %u outside inherited allowed affinity", cpu);
+          else if (i < tr->count && cpu == tm->main_lcore)
+            error = clib_error_return (
+              0, "ordered-workers: CPU %u conflicts with main-core", cpu);
+        }
+      clib_bitmap_free (allowed);
+      clib_bitmap_free (online);
+      if (error)
+        return error;
+      for (u32 i = 0; i < tr->count; i++)
+        tr->coremask = clib_bitmap_set (tr->coremask, ordered_worker_cpus[i], 1);
+      ordered_worker_registration = tr;
+    }
