diff --git a/src/vlib/threads.c b/src/vlib/threads.c
--- a/src/vlib/threads.c
+++ b/src/vlib/threads.c
@@ -31,4 +31,41 @@
 vlib_thread_main_t vlib_thread_main;
 
+/* Explicit startup placement is a sequence, not a CPU bitmap. It never
+ * participates in packet ownership and is immutable once workers launch. */
+static u32 *ordered_worker_cpus;
+static vlib_thread_registration_t *ordered_worker_registration;
+
+static clib_error_t *
+parse_ordered_worker_cpus (const u8 *text)
+{
+  const u8 *p = text;
+  if (vec_len (ordered_worker_cpus) || !*p)
+    return clib_error_return (0, "ordered-workers: empty or repeated list");
+  for (;;)
+    {
+      u32 cpu = 0;
+      if (*p < '0' || *p > '9')
+        return clib_error_return (0, "ordered-workers: expected decimal CPU ID");
+      do
+        {
+          u32 digit = *p++ - '0';
+          if (cpu > (CPU_SETSIZE - 1 - digit) / 10)
+            return clib_error_return (0, "ordered-workers: CPU ID out of range");
+          cpu = cpu * 10 + digit;
+        }
+      while (*p >= '0' && *p <= '9');
+      for (u32 i = 0; i < vec_len (ordered_worker_cpus); i++)
+        if (ordered_worker_cpus[i] == cpu)
+          return clib_error_return (0, "ordered-workers: duplicate CPU %u", cpu);
+      if (vec_len (ordered_worker_cpus) >= FRAME_QUEUE_MAX_NELTS - 1)
+        return clib_error_return (0, "ordered-workers: too many CPUs");
+      vec_add1 (ordered_worker_cpus, cpu);
+      if (!*p)
+        return 0;
+      if (*p++ != ',' || !*p)
+        return clib_error_return (0, "ordered-workers: expected comma and CPU");
+    }
+}
