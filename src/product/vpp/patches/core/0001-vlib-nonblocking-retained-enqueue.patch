+#ifndef CLIB_MARCH_VARIANT
+u32
+vlib_buffer_enqueue_to_thread_retained_fn (
+  vlib_main_t *vm, vlib_node_runtime_t *node, u32 frame_queue_index,
+  u32 *buffer_indices, u16 *thread_indices, u32 n_packets,
+  u32 *failed_buffer_indices)
+{
+  vlib_thread_main_t *tm = vlib_get_thread_main ();
+  vlib_frame_queue_main_t *fqm =
+    vec_elt_at_index (tm->frame_queue_mains, frame_queue_index);
+  u32 n_enq = 0;
+
+  while (n_packets)
+    {
+      u32 n_this = clib_min (n_packets, VLIB_FRAME_SIZE);
+      u32 n_this_enq = vlib_buffer_enqueue_to_thread_inline (
+	vm, node, fqm, buffer_indices, thread_indices, n_this,
+	1 /* dont_wait */, 0 /* with_aux */, NULL, failed_buffer_indices);
+
+      n_enq += n_this_enq;
+      failed_buffer_indices += n_this - n_this_enq;
+      buffer_indices += n_this;
+      thread_indices += n_this;
+      n_packets -= n_this;
+    }
+
+  return n_enq;
+}
+#endif
