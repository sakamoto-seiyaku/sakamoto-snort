+/*
+ * Try to enqueue without waiting for frame-queue space.  Rejected buffers are
+ * not freed; their indices are compacted into failed_buffer_indices.  The
+ * caller must provide room for n_packets failed indices and owns
+ * every rejected buffer.  The return value is the number enqueued.
+ */
+u32 vlib_buffer_enqueue_to_thread_retained_fn (
+  vlib_main_t *vm, vlib_node_runtime_t *node, u32 frame_queue_index,
+  u32 *buffer_indices, u16 *thread_indices, u32 n_packets,
+  u32 *failed_buffer_indices);
+
 typedef struct
 {
   vlib_buffer_enqueue_to_next_fn_t *buffer_enqueue_to_next_fn;
