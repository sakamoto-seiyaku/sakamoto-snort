@@ -427,6 +427,18 @@ vlib_buffer_enqueue_to_thread (vlib_main_t *vm, vlib_node_runtime_t *node,
 	       n_packets, drop_on_congestion);
 }
 
+/* Nonblocking enqueue which retains ownership of every rejected buffer. */
+static_always_inline u32
+vlib_buffer_enqueue_to_thread_retained (
+  vlib_main_t *vm, vlib_node_runtime_t *node, u32 frame_queue_index,
+  u32 *buffer_indices, u16 *thread_indices, u32 n_packets,
+  u32 *failed_buffer_indices)
+{
+  return vlib_buffer_enqueue_to_thread_retained_fn (
+    vm, node, frame_queue_index, buffer_indices, thread_indices, n_packets,
+    failed_buffer_indices);
+}
