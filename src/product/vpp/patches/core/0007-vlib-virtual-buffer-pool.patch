+  if (count == 0)
+    count = unpriv ? VLIB_BUFFER_DEFAULT_BUFFERS_PER_NUMA_UNPRIV :
+                     VLIB_BUFFER_DEFAULT_BUFFERS_PER_NUMA;
+  return count;
